# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=your-project-id
DOCUMENT_AI_PROCESSOR_ID=your-processor-id
DOCUMENT_AI_LOCATION=asia-southeast1
GEMINI_API_KEY=your-gemini-api-key

# Firestore Configuration (Option 1: Using Firebase Admin SDK)
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# Optional: Service Account Key Path (Option 2: Using JSON key file)
# Download from Google Cloud Console > IAM > Service Accounts > Keys
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json